{
  "name": "cours-enfants",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:maths": "npm run dev -w @ce/maths",
    "dev:espagnol": "npm run dev -w @ce/espagnol",
    "dev:hub": "npm run dev -w @ce/hub",
    "build": "node scripts/build-all.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "vitest run",
    "check": "svelte-check --threshold error",
    "e2e": "node tools/e2e/run.mjs",
    "cinematics:check": "node scripts/cinematics.mjs check",
    "art": "node scripts/cinematics.mjs art",
    "art:raster": "node tools/art/stadium-raster.mjs",
    "a11y:flash": "node tools/a11y/flash-check.mjs",
    "perf:frames": "node tools/perf/frame-times.mjs",
    "cinematics:sync": "node scripts/cinematics.mjs sync",
    "icons": "node scripts/make-icons.mjs",
    "voices": "node tools/tts/maths-manifest.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.0",
    "hyperframes": "^0.8.143",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.55.0",
    "sharp": "^0.34.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.0",
    "workbox-window": "^7.4.1"
  }
}
